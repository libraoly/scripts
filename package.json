{
  "name": "scripts",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance, tree-shakable task script library built with TypeScript",
  "keywords": [
    "esm",
    "scripts",
    "tasks",
    "toolkit",
    "tsdown",
    "typescript"
  ],
  "license": "UNLICENSED",
  "author": "libraoly <uylor.liao@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./balance": {
      "import": "./dist/balance.mjs",
      "require": "./dist/balance.cjs"
    },
    "./eva": {
      "import": "./dist/eva.mjs",
      "require": "./dist/eva.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "destr": "^2.0.5",
    "ky": "^2.1.0",
    "std-env": "^4.2.0",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.13.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.3.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
